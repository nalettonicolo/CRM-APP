# Esempio produzione — Nicolò Service + Netlify nicoloservice
# Copia sul server Mint come backend/.env (non committare segreti reali).

NODE_ENV=production
PORT=4000

# URL pubblico HTTPS dell'API (stesso valore che metti su Netlify in NEXT_PUBLIC_API_URL)
API_URL=https://api.tuodominio.it

# Sito Netlify
FRONTEND_URL=https://nicoloservice.netlify.app

# Login da Netlify con API su altro dominio
TRUST_CROSS_SITE_COOKIES=true
ALLOW_NETLIFY_PREVIEWS=true

# DB sullo stesso server Mint (localhost se Postgres è in locale)
DATABASE_URL=postgresql://postgres:PASSWORD@127.0.0.1:5432/crm_gestionale?schema=public

JWT_SECRET=sostituisci-con-stringa-random-lunga
JWT_REFRESH_SECRET=sostituisci-con-altra-stringa-random-lunga
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

ADMIN_EMAIL=nalettonicolo@gmail.com
ADMIN_PASSWORD=sostituisci-password-sicura

UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760
