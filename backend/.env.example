# Server
NODE_ENV=development
PORT=4000
API_URL=http://localhost:4000

# ─── PostgreSQL sul TUO SERVER ───────────────────────────────────────────────
# Formato:
# postgresql://UTENTE:PASSWORD@HOST_O_IP:5432/NOME_DATABASE?schema=public
#
# Database esistente (es. "Nicolò Service" in pgAdmin) — nome con spazi/accenti va codificato:
# Nicolò Service → Nicol%C3%B2%20Service
# DATABASE_URL=postgresql://postgres:PASSWORD@localhost:5432/Nicol%C3%B2%20Service?schema=public
#
# Esempio server remoto con database dedicato:
# DATABASE_URL=postgresql://crm_user:LaTuaPassword@192.168.1.100:5432/crm_gestionale?schema=public
#
# Con SSL (consigliato in produzione):
# DATABASE_URL=postgresql://crm_user:LaTuaPassword@db.tuodominio.it:5432/crm_gestionale?schema=public&sslmode=require
#
# Password con caratteri speciali (@, #, %): codifica in URL
# Es: p@ss#word → p%40ss%23word
DATABASE_URL=postgresql://crm_user:PASSWORD@TUO_SERVER_IP:5432/crm_gestionale?schema=public

# Opzionale: timeout connessione (ms)
# DATABASE_CONNECT_TIMEOUT=10000

# JWT
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
JWT_REFRESH_SECRET=your-super-secret-refresh-key-min-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Frontend (CORS)
# Sviluppo locale:
FRONTEND_URL=http://localhost:3000
# Produzione Netlify (HTTPS), esempio:
# FRONTEND_URL=https://tu-sito.netlify.app
#
# Deploy preview / domini extra (lista separata da virgola):
# FRONTEND_URLS=https://branch--tu-sito.netlify.app
#
# Se frontend Netlify e API sono su domini DIVERSI, in produzione abilita cookie cross-site
# (refresh token). L’API deve usare HTTPS.
# TRUST_CROSS_SITE_COOKIES=true
# (oppure COOKIE_SAMESITE=none)
#
# Consenti deploy preview *.netlify.app senza elencarli (opzionale, valuta sicurezza):
# ALLOW_NETLIFY_PREVIEWS=true

# Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# SMTP Email — Gmail (usa Password per le app, non la password Gmail)
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tuaemail@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
SMTP_FROM=tuaemail@gmail.com
SMTP_FROM_NAME=Nicolò Service

# Backup automatico (script cron + rclone Drive)
# BACKUP_DIR=../backups
# BACKUP_RETENTION_DAYS=30
# RCLONE_REMOTE=gdrive
# RCLONE_PATH=CRM-Backups

# Backup (pg_dump verso cartella locale)
BACKUP_DIR=../backups
BACKUP_RETENTION_DAYS=30

# Primo utente SUPER_ADMIN creato da: npm run db:seed --workspace=backend
# Personalizza prima del seed in produzione.
ADMIN_EMAIL=admin@crm.local
ADMIN_PASSWORD=Admin123!
