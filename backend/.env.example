# Server
NODE_ENV=development
PORT=4100
API_URL=http://localhost:4100

# ─── PostgreSQL sul TUO SERVER ───────────────────────────────────────────────
# Formato:
# postgresql://UTENTE:PASSWORD@HOST_O_IP:5432/NOME_DATABASE?schema=public
#
# Database esistente (es. "Nicolò Service" in pgAdmin) — nome con spazi/accenti va codificato:
# Nicolò Service → Nicol%C3%B2%20Service
# DATABASE_URL=postgresql://postgres:PASSWORD@localhost:5432/Nicol%C3%B2%20Service?schema=public
#
# Esempio server remoto con database dedicato:
# DATABASE_URL=postgresql://crm_user:LaTuaPassword@192.168.1.100:5432/crm_gestionale?schema=public
#
# Con SSL (consigliato in produzione):
# DATABASE_URL=postgresql://crm_user:LaTuaPassword@db.tuodominio.it:5432/crm_gestionale?schema=public&sslmode=require
#
# Password con caratteri speciali (@, #, %): codifica in URL
# Es: p@ss#word → p%40ss%23word
DATABASE_URL=postgresql://crm_user:PASSWORD@TUO_SERVER_IP:5432/crm_gestionale?schema=public

# Database parallelo Impianti Elettrici (stesso schema, dati separati)
# Locale (stesso host, nome DB diverso):
# DATABASE_URL_IE=postgresql://crm_user:PASSWORD@localhost:5432/crm_impianti_elettrici?schema=public
DATABASE_URL_IE=

# Opzionale: timeout connessione (ms)
# DATABASE_CONNECT_TIMEOUT=10000

# JWT
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
JWT_REFRESH_SECRET=your-super-secret-refresh-key-min-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Frontend (CORS)
# Sviluppo locale:
FRONTEND_URL=http://localhost:3000
# Produzione Netlify (HTTPS), esempio:
# FRONTEND_URL=https://tu-sito.netlify.app
#
# Deploy preview / domini extra (lista separata da virgola):
# FRONTEND_URLS=https://branch--tu-sito.netlify.app
#
# Se frontend Netlify e API sono su domini DIVERSI, in produzione abilita cookie cross-site
# (refresh token). L’API deve usare HTTPS.
# TRUST_CROSS_SITE_COOKIES=true
# (oppure COOKIE_SAMESITE=none)
#
# Consenti deploy preview *.netlify.app senza elencarli (opzionale, valuta sicurezza):
# ALLOW_NETLIFY_PREVIEWS=true

# Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760
# Cataloghi PDF fornitori (default 150 MB)
# CATALOG_MAX_FILE_SIZE=157286400

# SMTP Email — Gmail (usa Password per le app, non la password Gmail)
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tuaemail@gmail.com
SMTP_PASS="xxxx xxxx xxxx xxxx"
SMTP_FROM=tuaemail@gmail.com
SMTP_FROM_NAME="Nicolò Service"

# Backup automatico (script cron + rclone Drive)
# BACKUP_DIR=../backups
# BACKUP_RETENTION_DAYS=30
# LEAD_RETENTION_DAYS=730
# ACTIVITY_LOG_RETENTION_DAYS=1095
# RCLONE_REMOTE=gdrive
# RCLONE_PATH=CRM-Backups

# Backup (pg_dump verso cartella locale)
BACKUP_DIR=../backups
BACKUP_RETENTION_DAYS=30

# Notifiche form contatti (se diversa da SMTP_FROM)
# NOTIFY_EMAIL=info@tuodominio.it

# Dati demo nel seed (clienti/prodotti di esempio): solo se serve
# SEED_DEMO_DATA=true

# Primo utente SUPER_ADMIN creato da: npm run db:seed --workspace=backend
ADMIN_EMAIL=admin@crm.local
ADMIN_PASSWORD=Admin123!

# Token tunnel Cloudflare (creato dal pannello Zero Trust — vedi docs/guida-tunnel-da-sito-cloudflare.md)
# CLOUDFLARE_TUNNEL_TOKEN=eyJ...

# Sync automatico Netlify quando cambia API_URL (senza dominio — vedi docs/guida-api-stabile-senza-dominio.md)
# NETLIFY_AUTH_TOKEN=nfp_xxxxxxxx
# NETLIFY_SITE_ID=6262024d-df81-4d4c-867b-1410dba7a9dd

# Tailscale Funnel (URL .ts.net stabile, senza dominio) — vedi docs/guida-tailscale-funnel.md
# USE_TAILSCALE_FUNNEL=true
# TAILSCALE_FUNNEL_URL=https://mint-casa.tailxxxxx.ts.net
# API_URL=https://mint-casa.tailxxxxx.ts.net
# FRONTEND_URL=https://nicoloservice.netlify.app
# TRUST_CROSS_SITE_COOKIES=true

# ─── Produzione autonoma (Mint + dominio, senza Netlify) ─────────────────────
# Guida: docs/guida-deploy-autonomo-mint-dominio.md
# ./backend/scripts/configura-dominio-mint.sh https://www.tuo-dominio.it 4100
#
# NODE_ENV=production
# PORT=4100
# API_URL=https://www.tuo-dominio.it
# FRONTEND_URL=https://www.tuo-dominio.it
# DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/crm_gestionale?schema=public
#
# Frontend: frontend/.env.production (NEXT_PUBLIC_API_URL + API_INTERNAL_URL)
#
# ─── Solo se frontend resta su Netlify e API su sottodominio ─────────────────
# FRONTEND_URL=https://tu-sito.netlify.app
# API_URL=https://api.tuo-dominio.it
# TRUST_CROSS_SITE_COOKIES=true
# ALLOW_NETLIFY_PREVIEWS=true
