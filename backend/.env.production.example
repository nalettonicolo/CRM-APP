# Copia questo file sul VPS come .env (non committare .env con segreti veri).
# NODE_ENV=production richiesto per cookie Secure ecc.

NODE_ENV=production
PORT=4000

# URL pubblico dell’API (HTTPS)
API_URL=https://api.tuo-dominio.it

# Dominio Netlify del frontend (HTTPS, senza slash finale)
FRONTEND_URL=https://tuo-sito.netlify.app

# Deploy preview aggiuntivi (opzionale, virgole separate):
# FRONTEND_URLS=https://branch--tuo-sito.netlify.app

# Frontend Netlify + API altro dominio → cookie refresh cross-site (API deve essere HTTPS)
TRUST_CROSS_SITE_COOKIES=true

# Opzionale: accetta tutti *.netlify.app (preview). Valuta rischio sicurezza.
# ALLOW_NETLIFY_PREVIEWS=true

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/crm_gestionale
JWT_SECRET=minimo-32-caratteri-random
JWT_REFRESH_SECRET=altri-32-caratteri-random
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

SMTP_HOST=smtp.tuo-provider.it
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@tuo-dominio.it
SMTP_FROM_NAME=NexusCRM

UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760
