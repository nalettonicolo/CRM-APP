generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ───────────────────────────────────────────────────────────────────

enum UserRole {
  SUPER_ADMIN
  ADMIN
  COMMERCIAL
  TECHNICIAN
  OPERATOR
  WAREHOUSE
  CLIENT
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum PermissionAction {
  CREATE
  READ
  UPDATE
  DELETE
  MANAGE_USERS
  MANAGE_QUOTES
  MANAGE_REPORTS
  MANAGE_INVENTORY
  MANAGE_CLIENTS
  READ_ONLY
  LIMITED_ACCESS
  OWN_RESOURCES_ONLY
}

enum ClientStatus {
  LEAD
  PROSPECT
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
  OVERDUE
}

enum InvoiceStatus {
  DRAFT
  CONFIRMED
}

enum PaymentMethod {
  BANK_TRANSFER
  CASH
  CARD
  PAYPAL
  OTHER
}

enum InvoicePaymentTiming {
  END_OF_WORK
  DAYS_15
  DAYS_30
  DAYS_60
  ON_RECEIPT
  AT_SIGNATURE
}

enum InterventionStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  ON_HOLD
}

enum ReportStatus {
  DRAFT
  SUBMITTED
  APPROVED
  ARCHIVED
}

enum InventoryMovementType {
  IN
  OUT
  ADJUSTMENT
  TRANSFER
  RESERVATION
  RELEASE
}

enum EventType {
  APPOINTMENT
  INTERVENTION
  DEADLINE
  REMINDER
  MEETING
  SITE_VISIT
  EVENT
  RENTAL
  OTHER
}

enum NotificationType {
  INFO
  WARNING
  ALERT
  SUCCESS
}

enum AttachmentEntity {
  CLIENT
  QUOTE
  INTERVENTION
  REPORT
  PRODUCT
  INVOICE_PREVIEW
  USER
  EVENT
  SITE_VISIT
  JOB_ORDER
  SUPPLIER_CATALOG
  SUPPLIER_BILL
  CLIENT_EXPENSE
}

enum SiteVisitStatus {
  DRAFT
  COMPLETED
}

enum JobOrderStatus {
  DRAFT
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  INVOICED
}

enum SupplierCatalogKind {
  PDF
  PRICE_LIST
}

enum SupplierCatalogFileRole {
  PRICE_LIST
  CATALOG
  OTHER
}

enum SupplierBillStatus {
  UNPAID
  PARTIAL
  PAID
  OVERDUE
}

enum ExpenseStatus {
  UNPAID
  PARTIAL
  PAID
  OVERDUE
}

enum ActivityAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  EXPORT
  SEND_EMAIL
  SIGN
  UPLOAD
}

// ─── AUTH & RBAC ─────────────────────────────────────────────────────────────

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  passwordHash  String
  firstName     String
  lastName      String
  phone         String?
  avatar        String?
  role          UserRole   @default(OPERATOR)
  status        UserStatus @default(ACTIVE)
  clientId      String?
  client        Client?    @relation(fields: [clientId], references: [id])
  refreshTokens RefreshToken[]
  permissions   UserPermission[]
  interventions Intervention[] @relation("TechnicianInterventions")
  reports       InterventionReport[] @relation("TechnicianReports")
  quotes        Quote[] @relation("QuoteCreator")
  paymentsRecorded ClientPayment[] @relation("PaymentRecorder")
  transportDocuments TransportDocument[] @relation("TransportDocumentCreator")
  jobOrders     JobOrder[] @relation("JobOrderCreator")
  dailyReports  JobDailyReport[] @relation("DailyReportAuthor")
  events        Event[] @relation("EventAssignee")
  siteVisits    SiteVisit[] @relation("SiteVisitAuthor")
  activityLogs  ActivityLog[]
  notifications Notification[]
  passwordResets PasswordReset[]
  dashboardLayout Json?
  twoFactorEnabled Boolean @default(false)
  twoFactorSecret  String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  lastLoginAt   DateTime?
  createdById   String?

  @@index([email])
  @@index([role])
  @@index([clientId])
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  revoked   Boolean  @default(false)

  @@index([userId])
  @@index([token])
}

model PasswordReset {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([token])
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  slug        UserRole         @unique
  description String?
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Permission {
  id          String           @id @default(cuid())
  name        String
  resource    String
  action      PermissionAction
  description String?
  roles       RolePermission[]
  users       UserPermission[]
  createdAt   DateTime         @default(now())

  @@unique([resource, action])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserPermission {
  userId       String
  permissionId String
  granted      Boolean    @default(true)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([userId, permissionId])
}

// ─── CRM ─────────────────────────────────────────────────────────────────────

model Client {
  id              String       @id @default(cuid())
  companyName     String?
  firstName       String?
  lastName        String?
  contactName     String?
  email           String?
  phone           String?
  mobile          String?
  address         String?
  city            String?
  province        String?
  postalCode      String?
  country         String?      @default("IT")
  vatNumber       String?
  fiscalCode      String?
  pec             String?
  sdiCode         String?
  notes           String?      @db.Text
  tags            String[]
  status          ClientStatus @default(LEAD)
  users           User[]
  clientAccounts  ClientAccount[]
  leads           Lead[]
  quotes          Quote[]
  interventions   Intervention[]
  reports         InterventionReport[]
  events          Event[]
  siteVisits      SiteVisit[]
  invoicePreviews InvoicePreview[]
  payments            ClientPayment[]
  transportDocuments  TransportDocument[]
  jobOrders           JobOrder[]
  expenses            ClientExpense[]
  attachments         Attachment[] @relation("ClientAttachments")
  activities          ActivityLog[]
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@index([email])
  @@index([status])
  @@index([companyName])
}

model ClientAccount {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  username  String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
}

model Lead {
  id            String    @id @default(cuid())
  clientId      String?
  client        Client?   @relation(fields: [clientId], references: [id])
  name          String
  email         String
  phone         String?
  company       String?
  message       String?   @db.Text
  eventDateFrom DateTime?
  eventDateTo     DateTime?
  services      String[] @default([])
  source      String?  @default("website")
  status      String   @default("new")
  assignedTo  String?
  privacyConsentAt      DateTime?
  privacyPolicyVersion  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([email])
}

// ─── CATALOG ─────────────────────────────────────────────────────────────────

model Service {
  id           String      @id @default(cuid())
  name         String
  description  String?     @db.Text
  category     String?
  unit         String?
  price        Decimal     @db.Decimal(12, 2)
  vatRate      Decimal     @default(22) @db.Decimal(5, 2)
  vatExempt    Boolean     @default(false)
  duration     Int?
  operatorCost Decimal?    @db.Decimal(12, 2)
  isActive     Boolean     @default(true)
  quoteItems   QuoteItem[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([category])
}

model Product {
  id           String              @id @default(cuid())
  name         String
  sku          String              @unique
  description  String?             @db.Text
  category     String?
  isRentable   Boolean             @default(false)
  unit         String?
  price        Decimal             @db.Decimal(12, 2)
  cost         Decimal?            @db.Decimal(12, 2)
  vatRate      Decimal             @default(22) @db.Decimal(5, 2)
  supplierId   String?
  supplier     Supplier?           @relation(fields: [supplierId], references: [id])
  imageUrl     String?
  barcode      String?
  qrCode       String?
  isActive     Boolean             @default(true)
  inventory    Inventory?
  quoteItems              QuoteItem[]
  reportMaterials         ReportMaterial[]
  transportDocumentLines  TransportDocumentLine[]
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt

  @@index([sku])
  @@index([category])
  @@index([barcode])
}

model Supplier {
  id        String    @id @default(cuid())
  name      String
  email     String?
  phone     String?
  address   String?
  notes     String?   @db.Text
  products  Product[]
  catalogs  SupplierCatalog[]
  bills     SupplierBill[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

// ─── COMMESSE IMPIANTI / CATALOGHI FORNITORI ─────────────────────────────────

model JobOrder {
  id            String         @id @default(cuid())
  number        String         @unique
  clientId      String
  client        Client         @relation(fields: [clientId], references: [id])
  createdById   String
  createdBy     User           @relation("JobOrderCreator", fields: [createdById], references: [id])
  quoteId       String?
  quote         Quote?         @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  title         String
  description   String?        @db.Text
  workType      String?
  status        JobOrderStatus @default(DRAFT)
  plannedStart  DateTime?
  plannedEnd    DateTime?
  estimatedDays Int?
  location      String?
  notes         String?        @db.Text
  dailyReports  JobDailyReport[]
  invoicePreviews InvoicePreview[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([clientId])
  @@index([status])
  @@index([number])
  @@index([plannedStart])
}

model JobDailyReport {
  id           String      @id @default(cuid())
  number       String      @unique
  jobOrderId   String?
  jobOrder     JobOrder?   @relation(fields: [jobOrderId], references: [id], onDelete: SetNull)
  authorId     String?
  author       User?       @relation("DailyReportAuthor", fields: [authorId], references: [id])
  workDate     DateTime
  status       ReportStatus @default(DRAFT)
  description  String?     @db.Text
  workHours    Decimal     @default(0) @db.Decimal(8, 2)
  expensesAmount Decimal   @default(0) @db.Decimal(12, 2)
  expensesNotes String?    @db.Text
  materials    Json?
  checklist    Json?
  notes        String?     @db.Text
  submittedAt  DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([jobOrderId, workDate])
  @@index([jobOrderId])
  @@index([workDate])
  @@index([status])
}

model SupplierCatalog {
  id              String              @id @default(cuid())
  supplierId      String?
  supplier        Supplier?           @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  supplierName    String
  title           String
  kind            SupplierCatalogKind @default(PDF)
  /// Area catalogo: ELECTRICAL (civile/Bticino) | SECURITY (antifurti/Ajax).
  category        String              @default("ELECTRICAL")
  description     String?             @db.Text
  /// Legacy singolo file (mantenuto in sync col primo allegato).
  filePath        String?
  fileName        String?
  mimeType        String?
  fileSize        Int?
  defaultDiscountPercent Decimal      @default(0) @db.Decimal(5, 2)
  validFrom       DateTime?
  validTo         DateTime?
  isActive        Boolean             @default(true)
  items           SupplierCatalogItem[]
  files           SupplierCatalogFile[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([supplierId])
  @@index([kind])
  @@index([supplierName])
  @@index([category])
}

/// Allegati multipli (listino prezzi + catalogo immagini, ecc.).
model SupplierCatalogFile {
  id        String                  @id @default(cuid())
  catalogId String
  catalog   SupplierCatalog         @relation(fields: [catalogId], references: [id], onDelete: Cascade)
  role      SupplierCatalogFileRole @default(OTHER)
  label     String?
  filePath  String
  fileName  String?
  mimeType  String?
  fileSize  Int?
  sortOrder Int                     @default(0)
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt

  @@index([catalogId])
  @@index([role])
}

model SupplierCatalogItem {
  id              String          @id @default(cuid())
  catalogId       String
  catalog         SupplierCatalog @relation(fields: [catalogId], references: [id], onDelete: Cascade)
  sortOrder       Int             @default(0)
  sku             String?
  name            String
  unit            String?
  listPrice       Decimal         @db.Decimal(12, 2)
  discountPercent Decimal         @default(0) @db.Decimal(5, 2)
  /// Prezzo di vendita al cliente (opzionale). Se assente, in preventivo si usa il listino.
  sellPrice       Decimal?        @db.Decimal(12, 2)
  notes           String?
  /// Provenienza merge (es. listino RR + catalogo Living Now).
  sourceLabel     String?
  /// Linea prodotto (es. Living Now, Matix) per filtri preventivatore.
  productLine     String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([catalogId])
  @@index([sku])
  @@index([catalogId, productLine])
}

/// Ricevute / fatture fornitore (scadenze in entrata — area IE).
model SupplierBill {
  id            String             @id @default(cuid())
  number        String             @unique
  supplierId    String?
  supplier      Supplier?          @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  supplierName  String
  description   String?
  invoiceDate   DateTime           @default(now())
  dueDate       DateTime?
  amount        Decimal            @db.Decimal(12, 2)
  vatAmount     Decimal            @default(0) @db.Decimal(12, 2)
  total         Decimal            @db.Decimal(12, 2)
  paidAmount    Decimal            @default(0) @db.Decimal(12, 2)
  status        SupplierBillStatus @default(UNPAID)
  paidAt        DateTime?
  reference     String?
  notes         String?            @db.Text
  /// Documento allegato (PDF/immagine della fattura/ricevuta)
  filePath      String?
  fileName      String?
  mimeType      String?
  fileSize      Int?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([supplierId])
  @@index([dueDate])
  @@index([status])
  @@index([invoiceDate])
}

/// Spese / costi legati a un cliente (con documento e scadenza).
model ClientExpense {
  id            String        @id @default(cuid())
  number        String        @unique
  clientId      String?
  client        Client?       @relation(fields: [clientId], references: [id], onDelete: SetNull)
  clientName    String
  category      String?
  description   String?
  expenseDate   DateTime      @default(now())
  dueDate       DateTime?
  amount        Decimal       @db.Decimal(12, 2)
  vatAmount     Decimal       @default(0) @db.Decimal(12, 2)
  total         Decimal       @db.Decimal(12, 2)
  paidAmount    Decimal       @default(0) @db.Decimal(12, 2)
  status        ExpenseStatus @default(UNPAID)
  paidAt        DateTime?
  reference     String?
  notes         String?       @db.Text
  filePath      String?
  fileName      String?
  mimeType      String?
  fileSize      Int?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([clientId])
  @@index([dueDate])
  @@index([status])
  @@index([expenseDate])
}

// ─── QUOTES ──────────────────────────────────────────────────────────────────

model Quote {
  id              String        @id @default(cuid())
  number          String        @unique
  clientId        String
  client          Client        @relation(fields: [clientId], references: [id])
  createdById     String
  createdBy       User          @relation("QuoteCreator", fields: [createdById], references: [id])
  title           String?
  status          QuoteStatus   @default(DRAFT)
  paymentStatus   PaymentStatus @default(UNPAID)
  subtotal        Decimal       @default(0) @db.Decimal(12, 2)
  discountPercent Decimal       @default(0) @db.Decimal(5, 2)
  discountAmount  Decimal       @default(0) @db.Decimal(12, 2)
  vatAmount       Decimal       @default(0) @db.Decimal(12, 2)
  total           Decimal       @default(0) @db.Decimal(12, 2)
  depositPercent  Decimal       @default(0) @db.Decimal(5, 2)
  depositAmount   Decimal       @default(0) @db.Decimal(12, 2)
  balanceDue      Decimal       @default(0) @db.Decimal(12, 2)
  withholdingTaxPercent Decimal @default(0) @db.Decimal(5, 2)
  withholdingTaxAmount  Decimal @default(0) @db.Decimal(12, 2)
  stampDutyAmount       Decimal @default(0) @db.Decimal(12, 2)
  netPayable            Decimal @default(0) @db.Decimal(12, 2)
  rejectedAt      DateTime?
  validUntil      DateTime?
  notes           String?       @db.Text
  internalNotes   String?       @db.Text
  category        String?
  signedAt        DateTime?
  signedByClient  Boolean       @default(false)
  clientSignature String?       @db.Text
  sentAt          DateTime?
  acceptedAt      DateTime?
  eventAt         DateTime?
  eventEndAt      DateTime?
  eventLocation   String?
  paymentMethod   PaymentMethod       @default(BANK_TRANSFER)
  paymentTiming   InvoicePaymentTiming @default(END_OF_WORK)
  items           QuoteItem[]
  calendarEvents  Event[]
  paymentTerms    QuotePaymentTerm[]
  attachments     Attachment[]  @relation("QuoteAttachments")
  invoicePreviews InvoicePreview[]
  payments        ClientPayment[]
  reports             InterventionReport[]
  siteVisits          SiteVisit[]
  transportDocuments  TransportDocument[]
  jobOrders           JobOrder[]
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@index([clientId])
  @@index([status])
  @@index([number])
}

model ClientPayment {
  id                 String        @id @default(cuid())
  clientId           String
  client             Client        @relation(fields: [clientId], references: [id])
  quoteId            String?
  quote              Quote?        @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  quotePaymentTermId String?
  quotePaymentTerm   QuotePaymentTerm? @relation("TermPayments", fields: [quotePaymentTermId], references: [id], onDelete: SetNull)
  label              String
  amount             Decimal       @db.Decimal(12, 2)
  paidAt             DateTime      @default(now())
  method             PaymentMethod @default(BANK_TRANSFER)
  reference          String?
  notes              String?       @db.Text
  createdById        String
  createdBy          User          @relation("PaymentRecorder", fields: [createdById], references: [id])
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([clientId])
  @@index([quoteId])
  @@index([paidAt])
}

model QuotePaymentTerm {
  id        String    @id @default(cuid())
  quoteId   String
  quote     Quote     @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  label     String
  note      String?   @db.Text
  percent   Decimal?  @db.Decimal(5, 2)
  amount    Decimal   @default(0) @db.Decimal(12, 2)
  isBalance Boolean   @default(false)
  dueDate   DateTime?
  sortOrder Int       @default(0)
  payments  ClientPayment[] @relation("TermPayments")

  @@index([quoteId])
  @@index([dueDate])
}

model PaymentTermTemplate {
  id        String                      @id @default(cuid())
  name      String
  isDefault Boolean                     @default(false)
  items     PaymentTermTemplateItem[]
  createdAt DateTime                    @default(now())
  updatedAt DateTime                    @updatedAt
}

model PaymentTermTemplateItem {
  id         String              @id @default(cuid())
  templateId String
  template   PaymentTermTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  label      String
  note       String?             @db.Text
  percent    Decimal?            @db.Decimal(5, 2)
  amount     Decimal?            @db.Decimal(12, 2)
  isBalance  Boolean             @default(false)
  sortOrder  Int                 @default(0)

  @@index([templateId])
}

model QuoteItem {
  id          String   @id @default(cuid())
  quoteId     String
  quote       Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  type        String
  description String
  quantity    Decimal  @db.Decimal(12, 3)
  unit        String?
  unitPrice   Decimal  @db.Decimal(12, 2)
  vatRate     Decimal  @default(22) @db.Decimal(5, 2)
  discount    Decimal  @default(0) @db.Decimal(5, 2)
  total       Decimal  @db.Decimal(12, 2)
  serviceId   String?
  service     Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  sortOrder   Int      @default(0)

  @@index([quoteId])
}

model QuoteAutomationRule {
  id              String   @id @default(cuid())
  name            String
  category        String
  isActive        Boolean  @default(true)
  discountPercent Decimal? @db.Decimal(5, 2)
  discountAmount  Decimal? @db.Decimal(12, 2)
  vatRate         Decimal? @db.Decimal(5, 2)
  autoItems       Json?
  conditions      Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([category])
}

// ─── INTERVENTIONS & REPORTS ─────────────────────────────────────────────────

model Intervention {
  id            String             @id @default(cuid())
  number        String             @unique
  clientId      String
  client        Client             @relation(fields: [clientId], references: [id])
  technicianId  String?
  technician    User?              @relation("TechnicianInterventions", fields: [technicianId], references: [id])
  title         String
  description   String?            @db.Text
  status        InterventionStatus @default(SCHEDULED)
  scheduledAt   DateTime?
  startedAt     DateTime?
  completedAt   DateTime?
  location      String?
  latitude      Decimal?           @db.Decimal(10, 7)
  longitude     Decimal?           @db.Decimal(10, 7)
  reports       InterventionReport[]
  events        Event[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([clientId])
  @@index([technicianId])
  @@index([status])
}

model InterventionReport {
  id              String       @id @default(cuid())
  number          String       @unique
  interventionId  String?
  intervention    Intervention? @relation(fields: [interventionId], references: [id])
  quoteId         String?
  quote           Quote?       @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  clientId        String
  client          Client       @relation(fields: [clientId], references: [id])
  technicianId    String
  technician      User         @relation("TechnicianReports", fields: [technicianId], references: [id])
  status          ReportStatus @default(DRAFT)
  description     String?      @db.Text
  workHours       Decimal      @default(0) @db.Decimal(6, 2)
  kmTraveled      Decimal      @default(0) @db.Decimal(10, 2)
  expensesAmount  Decimal      @default(0) @db.Decimal(12, 2)
  expensesNotes   String?      @db.Text
  checklist       Json?
  technicianSignature String?
  clientSignature String?
  latitude        Decimal?     @db.Decimal(10, 7)
  longitude       Decimal?     @db.Decimal(10, 7)
  checkInAt       DateTime?
  checkOutAt      DateTime?
  submittedAt     DateTime?
  materials       ReportMaterial[]
  attachments     Attachment[] @relation("ReportAttachments")
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([clientId])
  @@index([quoteId])
  @@index([technicianId])
  @@index([status])
}

model ReportMaterial {
  id        String             @id @default(cuid())
  reportId  String
  report    InterventionReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  productId String?
  product   Product?           @relation(fields: [productId], references: [id])
  name      String
  quantity  Decimal            @db.Decimal(12, 3)
  unit      String?            @default("pz")

  @@index([reportId])
}

// ─── INVENTORY ───────────────────────────────────────────────────────────────

model Warehouse {
  id        String      @id @default(cuid())
  name      String
  address   String?
  isDefault Boolean     @default(false)
  inventory Inventory[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model Inventory {
  id            String              @id @default(cuid())
  productId     String              @unique
  product       Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouseId   String
  warehouse     Warehouse           @relation(fields: [warehouseId], references: [id])
  quantity      Decimal             @default(0) @db.Decimal(12, 3)
  minStock      Decimal             @default(0) @db.Decimal(12, 3)
  maxStock      Decimal?            @db.Decimal(12, 3)
  reservedQty   Decimal             @default(0) @db.Decimal(12, 3)
  movements     InventoryMovement[]
  updatedAt     DateTime            @updatedAt

  @@index([warehouseId])
}

model InventoryMovement {
  id          String                @id @default(cuid())
  inventoryId String
  inventory   Inventory             @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  type        InventoryMovementType
  quantity    Decimal               @db.Decimal(12, 3)
  reference   String?
  notes       String?
  createdById String?
  createdAt   DateTime              @default(now())

  @@index([inventoryId])
  @@index([createdAt])
}

// ─── EVENTS & INVOICES ───────────────────────────────────────────────────────

model Event {
  id           String    @id @default(cuid())
  title        String
  description  String?   @db.Text
  type         EventType @default(APPOINTMENT)
  startAt      DateTime
  endAt        DateTime?
  allDay       Boolean   @default(false)
  clientId     String?
  client       Client?   @relation(fields: [clientId], references: [id])
  assigneeId   String?
  assignee     User?     @relation("EventAssignee", fields: [assigneeId], references: [id])
  interventionId String?
  intervention Intervention? @relation(fields: [interventionId], references: [id])
  quoteId        String?
  quote          Quote?        @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  location     String?
  reminderAt   DateTime?
  color        String?
  siteVisit    SiteVisit?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([startAt])
  @@index([clientId])
  @@index([assigneeId])
  @@index([quoteId])
}

model SiteVisit {
  id             String          @id @default(cuid())
  number         String          @unique
  eventId        String          @unique
  event          Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  clientId       String?
  client         Client?         @relation(fields: [clientId], references: [id])
  quoteId        String?
  quote          Quote?          @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  conductedById  String?
  conductedBy    User?           @relation("SiteVisitAuthor", fields: [conductedById], references: [id])
  status         SiteVisitStatus @default(DRAFT)
  location       String?
  venueNotes     String?         @db.Text
  audioNotes     String?         @db.Text
  lightingNotes  String?         @db.Text
  accessNotes    String?         @db.Text
  generalNotes   String?         @db.Text
  conductedAt    DateTime?
  attachments    Attachment[]    @relation("SiteVisitAttachments")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([clientId])
  @@index([quoteId])
  @@index([conductedById])
}

model InvoicePreview {
  id            String        @id @default(cuid())
  number        String?       @unique
  clientId      String
  client        Client        @relation(fields: [clientId], references: [id])
  quoteId       String?
  quote         Quote?        @relation(fields: [quoteId], references: [id])
  jobOrderId    String?
  jobOrder      JobOrder?     @relation(fields: [jobOrderId], references: [id], onDelete: SetNull)
  subtotal      Decimal       @db.Decimal(12, 2)
  vatAmount     Decimal       @db.Decimal(12, 2)
  total         Decimal       @db.Decimal(12, 2)
  depositAmount Decimal       @default(0) @db.Decimal(12, 2)
  balanceDue    Decimal       @db.Decimal(12, 2)
  paymentStatus PaymentStatus       @default(UNPAID)
  paymentMethod PaymentMethod       @default(BANK_TRANSFER)
  paymentTiming InvoicePaymentTiming @default(END_OF_WORK)
  status        InvoiceStatus       @default(DRAFT)
  dueDate       DateTime?
  eventAt       DateTime?
  eventEndAt    DateTime?
  eventLocation String?
  items         Json?
  discounts     Json?
  notes         String?       @db.Text
  disclaimer    String        @default("Documento emesso a solo scopo informativo e gestionale. Non costituisce fattura né documento fiscale ai sensi del D.P.R. 633/1972 e non sostituisce la fatturazione elettronica ove prevista dalla legge.")
  showWebsite   Boolean       @default(true)
  showQuoteRef  Boolean       @default(true)
  sentAt        DateTime?
  confirmedAt   DateTime?
  attachments   Attachment[]  @relation("InvoiceAttachments")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([clientId])
  @@index([jobOrderId])
}

// ─── SHARED ──────────────────────────────────────────────────────────────────

model Attachment {
  id           String           @id @default(cuid())
  filename     String
  originalName String
  mimeType     String
  size         Int
  path         String
  entityType   AttachmentEntity
  entityId     String
  uploadedById String?
  clientId     String?
  client       Client?          @relation("ClientAttachments", fields: [clientId], references: [id])
  quoteId      String?
  quote        Quote?           @relation("QuoteAttachments", fields: [quoteId], references: [id])
  reportId     String?
  report       InterventionReport? @relation("ReportAttachments", fields: [reportId], references: [id])
  invoiceId    String?
  invoice      InvoicePreview?  @relation("InvoiceAttachments", fields: [invoiceId], references: [id])
  siteVisitId  String?
  siteVisit    SiteVisit?       @relation("SiteVisitAttachments", fields: [siteVisitId], references: [id])
  createdAt    DateTime         @default(now())

  @@index([entityType, entityId])
}

model ActivityLog {
  id         String         @id @default(cuid())
  userId     String?
  user       User?          @relation(fields: [userId], references: [id])
  clientId   String?
  client     Client?        @relation(fields: [clientId], references: [id])
  action     ActivityAction
  entityType String?
  entityId   String?
  details    Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime       @default(now())

  @@index([userId])
  @@index([clientId])
  @@index([createdAt])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType @default(INFO)
  title     String
  message   String
  link      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, isRead])
}

model EventGalleryItem {
  id          String    @id @default(cuid())
  title       String?
  caption     String?   @db.Text
  eventDate   DateTime?
  imagePath   String
  isPublished Boolean   @default(true)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([isPublished, sortOrder])
}

// ─── DDT (Documento di Trasporto) ────────────────────────────────────────────

enum TransportDocumentStatus {
  DRAFT
  ISSUED
  DELIVERED
  CANCELLED
}

enum TransportReason {
  SALE
  RENTAL
  DEPOSIT
  LOAN
  RETURN
  REPAIR
  OTHER
}

enum TransportCarrier {
  SENDER
  RECIPIENT
  CARRIER
}

model TransportDocument {
  id                  String                  @id @default(cuid())
  number              String                  @unique
  status              TransportDocumentStatus @default(DRAFT)
  clientId            String
  client              Client                  @relation(fields: [clientId], references: [id])
  quoteId             String?
  quote               Quote?                  @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  createdById         String
  createdBy           User                    @relation("TransportDocumentCreator", fields: [createdById], references: [id])
  issueDate           DateTime                @default(now())
  transportStartAt    DateTime?
  recipientName       String?
  recipientAddress    String?
  recipientCity       String?
  recipientProvince   String?
  recipientPostalCode String?
  recipientVat        String?
  recipientFiscalCode String?
  destinationAddress  String?
  destinationCity     String?
  destinationProvince String?
  destinationPostalCode String?
  reason              TransportReason         @default(RENTAL)
  carrier             TransportCarrier        @default(SENDER)
  carrierName         String?
  vehiclePlate        String?
  driverName          String?
  packagesCount       Int?
  grossWeightKg       Decimal?                @db.Decimal(10, 2)
  appearance          String?
  referenceDoc        String?
  notes               String?                 @db.Text
  lines               TransportDocumentLine[]
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  @@index([clientId])
  @@index([status])
  @@index([number])
  @@index([issueDate])
}

model TransportDocumentLine {
  id          String            @id @default(cuid())
  documentId  String
  document    TransportDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  sortOrder   Int               @default(0)
  description String
  quantity    Decimal           @db.Decimal(12, 3)
  unit        String            @default("pz")
  sku         String?
  productId   String?
  product     Product?          @relation(fields: [productId], references: [id], onDelete: SetNull)
  notes       String?

  @@index([documentId])
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
}
