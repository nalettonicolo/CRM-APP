generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ───────────────────────────────────────────────────────────────────

enum UserRole {
  SUPER_ADMIN
  ADMIN
  COMMERCIAL
  TECHNICIAN
  OPERATOR
  WAREHOUSE
  CLIENT
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum PermissionAction {
  CREATE
  READ
  UPDATE
  DELETE
  MANAGE_USERS
  MANAGE_QUOTES
  MANAGE_REPORTS
  MANAGE_INVENTORY
  MANAGE_CLIENTS
  READ_ONLY
  LIMITED_ACCESS
  OWN_RESOURCES_ONLY
}

enum ClientStatus {
  LEAD
  PROSPECT
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
  OVERDUE
}

enum PaymentMethod {
  BANK_TRANSFER
  CASH
  CARD
  PAYPAL
  OTHER
}

enum InterventionStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  ON_HOLD
}

enum ReportStatus {
  DRAFT
  SUBMITTED
  APPROVED
  ARCHIVED
}

enum InventoryMovementType {
  IN
  OUT
  ADJUSTMENT
  TRANSFER
  RESERVATION
  RELEASE
}

enum EventType {
  APPOINTMENT
  INTERVENTION
  DEADLINE
  REMINDER
  MEETING
  OTHER
}

enum NotificationType {
  INFO
  WARNING
  ALERT
  SUCCESS
}

enum AttachmentEntity {
  CLIENT
  QUOTE
  INTERVENTION
  REPORT
  PRODUCT
  INVOICE_PREVIEW
  USER
  EVENT
}

enum ActivityAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  EXPORT
  SEND_EMAIL
  SIGN
  UPLOAD
}

// ─── AUTH & RBAC ─────────────────────────────────────────────────────────────

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  passwordHash  String
  firstName     String
  lastName      String
  phone         String?
  avatar        String?
  role          UserRole   @default(OPERATOR)
  status        UserStatus @default(ACTIVE)
  clientId      String?
  client        Client?    @relation(fields: [clientId], references: [id])
  refreshTokens RefreshToken[]
  permissions   UserPermission[]
  interventions Intervention[] @relation("TechnicianInterventions")
  reports       InterventionReport[] @relation("TechnicianReports")
  quotes        Quote[] @relation("QuoteCreator")
  paymentsRecorded ClientPayment[] @relation("PaymentRecorder")
  events        Event[] @relation("EventAssignee")
  activityLogs  ActivityLog[]
  notifications Notification[]
  passwordResets PasswordReset[]
  dashboardLayout Json?
  twoFactorEnabled Boolean @default(false)
  twoFactorSecret  String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  lastLoginAt   DateTime?
  createdById   String?

  @@index([email])
  @@index([role])
  @@index([clientId])
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  revoked   Boolean  @default(false)

  @@index([userId])
  @@index([token])
}

model PasswordReset {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([token])
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  slug        UserRole         @unique
  description String?
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Permission {
  id          String           @id @default(cuid())
  name        String
  resource    String
  action      PermissionAction
  description String?
  roles       RolePermission[]
  users       UserPermission[]
  createdAt   DateTime         @default(now())

  @@unique([resource, action])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserPermission {
  userId       String
  permissionId String
  granted      Boolean    @default(true)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([userId, permissionId])
}

// ─── CRM ─────────────────────────────────────────────────────────────────────

model Client {
  id              String       @id @default(cuid())
  companyName     String?
  firstName       String?
  lastName        String?
  contactName     String?
  email           String?
  phone           String?
  mobile          String?
  address         String?
  city            String?
  province        String?
  postalCode      String?
  country         String?      @default("IT")
  vatNumber       String?
  fiscalCode      String?
  notes           String?      @db.Text
  tags            String[]
  status          ClientStatus @default(LEAD)
  users           User[]
  clientAccounts  ClientAccount[]
  leads           Lead[]
  quotes          Quote[]
  interventions   Intervention[]
  reports         InterventionReport[]
  events          Event[]
  invoicePreviews InvoicePreview[]
  payments        ClientPayment[]
  attachments     Attachment[] @relation("ClientAttachments")
  activities      ActivityLog[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([email])
  @@index([status])
  @@index([companyName])
}

model ClientAccount {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  username  String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
}

model Lead {
  id          String   @id @default(cuid())
  clientId    String?
  client      Client?  @relation(fields: [clientId], references: [id])
  name        String
  email       String
  phone       String?
  company     String?
  message     String?  @db.Text
  services    String[] @default([])
  source      String?  @default("website")
  status      String   @default("new")
  assignedTo  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([email])
}

// ─── CATALOG ─────────────────────────────────────────────────────────────────

model Service {
  id           String      @id @default(cuid())
  name         String
  description  String?     @db.Text
  category     String?
  unit         String?
  price        Decimal     @db.Decimal(12, 2)
  vatRate      Decimal     @default(22) @db.Decimal(5, 2)
  vatExempt    Boolean     @default(false)
  duration     Int?
  operatorCost Decimal?    @db.Decimal(12, 2)
  isActive     Boolean     @default(true)
  quoteItems   QuoteItem[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([category])
}

model Product {
  id           String              @id @default(cuid())
  name         String
  sku          String              @unique
  description  String?             @db.Text
  category     String?
  price        Decimal             @db.Decimal(12, 2)
  cost         Decimal?            @db.Decimal(12, 2)
  vatRate      Decimal             @default(22) @db.Decimal(5, 2)
  supplierId   String?
  supplier     Supplier?           @relation(fields: [supplierId], references: [id])
  imageUrl     String?
  barcode      String?
  qrCode       String?
  isActive     Boolean             @default(true)
  inventory    Inventory?
  quoteItems   QuoteItem[]
  reportMaterials ReportMaterial[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([sku])
  @@index([category])
  @@index([barcode])
}

model Supplier {
  id        String    @id @default(cuid())
  name      String
  email     String?
  phone     String?
  address   String?
  notes     String?   @db.Text
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

// ─── QUOTES ──────────────────────────────────────────────────────────────────

model Quote {
  id              String        @id @default(cuid())
  number          String        @unique
  clientId        String
  client          Client        @relation(fields: [clientId], references: [id])
  createdById     String
  createdBy       User          @relation("QuoteCreator", fields: [createdById], references: [id])
  title           String?
  status          QuoteStatus   @default(DRAFT)
  paymentStatus   PaymentStatus @default(UNPAID)
  subtotal        Decimal       @default(0) @db.Decimal(12, 2)
  discountPercent Decimal       @default(0) @db.Decimal(5, 2)
  discountAmount  Decimal       @default(0) @db.Decimal(12, 2)
  vatAmount       Decimal       @default(0) @db.Decimal(12, 2)
  total           Decimal       @default(0) @db.Decimal(12, 2)
  depositPercent  Decimal       @default(0) @db.Decimal(5, 2)
  depositAmount   Decimal       @default(0) @db.Decimal(12, 2)
  balanceDue      Decimal       @default(0) @db.Decimal(12, 2)
  validUntil      DateTime?
  notes           String?       @db.Text
  internalNotes   String?       @db.Text
  category        String?
  signedAt        DateTime?
  signedByClient  Boolean       @default(false)
  clientSignature String?       @db.Text
  sentAt          DateTime?
  acceptedAt      DateTime?
  items           QuoteItem[]
  paymentTerms    QuotePaymentTerm[]
  attachments     Attachment[]  @relation("QuoteAttachments")
  invoicePreviews InvoicePreview[]
  payments        ClientPayment[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([clientId])
  @@index([status])
  @@index([number])
}

model ClientPayment {
  id                 String        @id @default(cuid())
  clientId           String
  client             Client        @relation(fields: [clientId], references: [id])
  quoteId            String?
  quote              Quote?        @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  quotePaymentTermId String?
  label              String
  amount             Decimal       @db.Decimal(12, 2)
  paidAt             DateTime      @default(now())
  method             PaymentMethod @default(BANK_TRANSFER)
  reference          String?
  notes              String?       @db.Text
  createdById        String
  createdBy          User          @relation("PaymentRecorder", fields: [createdById], references: [id])
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([clientId])
  @@index([quoteId])
  @@index([paidAt])
}

model QuotePaymentTerm {
  id        String   @id @default(cuid())
  quoteId   String
  quote     Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  label     String
  note      String?  @db.Text
  percent   Decimal? @db.Decimal(5, 2)
  amount    Decimal  @default(0) @db.Decimal(12, 2)
  isBalance Boolean  @default(false)
  sortOrder Int      @default(0)

  @@index([quoteId])
}

model PaymentTermTemplate {
  id        String                      @id @default(cuid())
  name      String
  isDefault Boolean                     @default(false)
  items     PaymentTermTemplateItem[]
  createdAt DateTime                    @default(now())
  updatedAt DateTime                    @updatedAt
}

model PaymentTermTemplateItem {
  id         String              @id @default(cuid())
  templateId String
  template   PaymentTermTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  label      String
  note       String?             @db.Text
  percent    Decimal?            @db.Decimal(5, 2)
  amount     Decimal?            @db.Decimal(12, 2)
  isBalance  Boolean             @default(false)
  sortOrder  Int                 @default(0)

  @@index([templateId])
}

model QuoteItem {
  id          String   @id @default(cuid())
  quoteId     String
  quote       Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  type        String
  description String
  quantity    Decimal  @db.Decimal(12, 3)
  unit        String?
  unitPrice   Decimal  @db.Decimal(12, 2)
  vatRate     Decimal  @default(22) @db.Decimal(5, 2)
  discount    Decimal  @default(0) @db.Decimal(5, 2)
  total       Decimal  @db.Decimal(12, 2)
  serviceId   String?
  service     Service? @relation(fields: [serviceId], references: [id])
  productId   String?
  product     Product? @relation(fields: [productId], references: [id])
  sortOrder   Int      @default(0)

  @@index([quoteId])
}

model QuoteAutomationRule {
  id              String   @id @default(cuid())
  name            String
  category        String
  isActive        Boolean  @default(true)
  discountPercent Decimal? @db.Decimal(5, 2)
  discountAmount  Decimal? @db.Decimal(12, 2)
  vatRate         Decimal? @db.Decimal(5, 2)
  autoItems       Json?
  conditions      Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([category])
}

// ─── INTERVENTIONS & REPORTS ─────────────────────────────────────────────────

model Intervention {
  id            String             @id @default(cuid())
  number        String             @unique
  clientId      String
  client        Client             @relation(fields: [clientId], references: [id])
  technicianId  String?
  technician    User?              @relation("TechnicianInterventions", fields: [technicianId], references: [id])
  title         String
  description   String?            @db.Text
  status        InterventionStatus @default(SCHEDULED)
  scheduledAt   DateTime?
  startedAt     DateTime?
  completedAt   DateTime?
  location      String?
  latitude      Decimal?           @db.Decimal(10, 7)
  longitude     Decimal?           @db.Decimal(10, 7)
  reports       InterventionReport[]
  events        Event[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([clientId])
  @@index([technicianId])
  @@index([status])
}

model InterventionReport {
  id              String       @id @default(cuid())
  number          String       @unique
  interventionId  String?
  intervention    Intervention? @relation(fields: [interventionId], references: [id])
  clientId        String
  client          Client       @relation(fields: [clientId], references: [id])
  technicianId    String
  technician      User         @relation("TechnicianReports", fields: [technicianId], references: [id])
  status          ReportStatus @default(DRAFT)
  description     String?      @db.Text
  workHours       Decimal      @default(0) @db.Decimal(6, 2)
  checklist       Json?
  technicianSignature String?
  clientSignature String?
  latitude        Decimal?     @db.Decimal(10, 7)
  longitude       Decimal?     @db.Decimal(10, 7)
  checkInAt       DateTime?
  checkOutAt      DateTime?
  submittedAt     DateTime?
  materials       ReportMaterial[]
  attachments     Attachment[] @relation("ReportAttachments")
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([clientId])
  @@index([technicianId])
  @@index([status])
}

model ReportMaterial {
  id        String             @id @default(cuid())
  reportId  String
  report    InterventionReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  productId String?
  product   Product?           @relation(fields: [productId], references: [id])
  name      String
  quantity  Decimal            @db.Decimal(12, 3)
  unit      String?            @default("pz")

  @@index([reportId])
}

// ─── INVENTORY ───────────────────────────────────────────────────────────────

model Warehouse {
  id        String      @id @default(cuid())
  name      String
  address   String?
  isDefault Boolean     @default(false)
  inventory Inventory[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model Inventory {
  id            String              @id @default(cuid())
  productId     String              @unique
  product       Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouseId   String
  warehouse     Warehouse           @relation(fields: [warehouseId], references: [id])
  quantity      Decimal             @default(0) @db.Decimal(12, 3)
  minStock      Decimal             @default(0) @db.Decimal(12, 3)
  maxStock      Decimal?            @db.Decimal(12, 3)
  reservedQty   Decimal             @default(0) @db.Decimal(12, 3)
  movements     InventoryMovement[]
  updatedAt     DateTime            @updatedAt

  @@index([warehouseId])
}

model InventoryMovement {
  id          String                @id @default(cuid())
  inventoryId String
  inventory   Inventory             @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  type        InventoryMovementType
  quantity    Decimal               @db.Decimal(12, 3)
  reference   String?
  notes       String?
  createdById String?
  createdAt   DateTime              @default(now())

  @@index([inventoryId])
  @@index([createdAt])
}

// ─── EVENTS & INVOICES ───────────────────────────────────────────────────────

model Event {
  id           String    @id @default(cuid())
  title        String
  description  String?   @db.Text
  type         EventType @default(APPOINTMENT)
  startAt      DateTime
  endAt        DateTime?
  allDay       Boolean   @default(false)
  clientId     String?
  client       Client?   @relation(fields: [clientId], references: [id])
  assigneeId   String?
  assignee     User?     @relation("EventAssignee", fields: [assigneeId], references: [id])
  interventionId String?
  intervention Intervention? @relation(fields: [interventionId], references: [id])
  reminderAt   DateTime?
  color        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([startAt])
  @@index([clientId])
  @@index([assigneeId])
}

model InvoicePreview {
  id            String        @id @default(cuid())
  number        String        @unique
  clientId      String
  client        Client        @relation(fields: [clientId], references: [id])
  quoteId       String?
  quote         Quote?        @relation(fields: [quoteId], references: [id])
  subtotal      Decimal       @db.Decimal(12, 2)
  vatAmount     Decimal       @db.Decimal(12, 2)
  total         Decimal       @db.Decimal(12, 2)
  depositAmount Decimal       @default(0) @db.Decimal(12, 2)
  balanceDue    Decimal       @db.Decimal(12, 2)
  paymentStatus PaymentStatus @default(UNPAID)
  dueDate       DateTime?
  notes         String?       @db.Text
  disclaimer    String        @default("Documento non valido ai fini fiscali. Non sostituisce fattura elettronica.")
  attachments   Attachment[]  @relation("InvoiceAttachments")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([clientId])
}

// ─── SHARED ──────────────────────────────────────────────────────────────────

model Attachment {
  id           String           @id @default(cuid())
  filename     String
  originalName String
  mimeType     String
  size         Int
  path         String
  entityType   AttachmentEntity
  entityId     String
  uploadedById String?
  clientId     String?
  client       Client?          @relation("ClientAttachments", fields: [clientId], references: [id])
  quoteId      String?
  quote        Quote?           @relation("QuoteAttachments", fields: [quoteId], references: [id])
  reportId     String?
  report       InterventionReport? @relation("ReportAttachments", fields: [reportId], references: [id])
  invoiceId    String?
  invoice      InvoicePreview?  @relation("InvoiceAttachments", fields: [invoiceId], references: [id])
  createdAt    DateTime         @default(now())

  @@index([entityType, entityId])
}

model ActivityLog {
  id         String         @id @default(cuid())
  userId     String?
  user       User?          @relation(fields: [userId], references: [id])
  clientId   String?
  client     Client?        @relation(fields: [clientId], references: [id])
  action     ActivityAction
  entityType String?
  entityId   String?
  details    Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime       @default(now())

  @@index([userId])
  @@index([clientId])
  @@index([createdAt])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType @default(INFO)
  title     String
  message   String
  link      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, isRead])
}

model EventGalleryItem {
  id          String    @id @default(cuid())
  title       String?
  caption     String?   @db.Text
  eventDate   DateTime?
  imagePath   String
  isPublished Boolean   @default(true)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([isPublished, sortOrder])
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
}
