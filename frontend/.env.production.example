# Copia su Mint: ~/CRM-APP/frontend/.env.production
# Usato al build/start del frontend (pm2 crm-web).
#
# Un solo dominio pubblico (consigliato): Next fa proxy di /api e /uploads verso Express.
NEXT_PUBLIC_API_URL=https://www.tuodominio.it
API_INTERNAL_URL=http://127.0.0.1:4100

# Opzionale: logo se l'API non è raggiungibile al build
# NEXT_PUBLIC_LOGO_URL=/uploads/branding/logo.png
