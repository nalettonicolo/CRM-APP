NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_NAME=Nicolò Service

# Logo home pubblica (opzionale): URL assoluto o path /uploads/... se l’API non risponde al build
# NEXT_PUBLIC_LOGO_URL=/uploads/branding/logo.png

# ─── Produzione (Netlify) ─────────────────────────────────────────────────────
# Punta all’API pubblica (HTTPS), senza slash finale:
# NEXT_PUBLIC_API_URL=https://api.tuodominio.it
#
# Il frontend chiama direttamente questa URL (vedi src/lib/api.ts).
# Su Netlify: Site settings → Environment variables → aggiungi NEXT_PUBLIC_API_URL
