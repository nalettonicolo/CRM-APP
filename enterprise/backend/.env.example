# Gestionale Enterprise — backend
# Porta diversa dal CRM-APP esistente (che usa 4000) per poter girare in parallelo.
PORT=5000

# Database dedicato (NON riusare crm_gestionale del CRM-APP: schema diverso).
# Con `docker compose up -d` (vedi ../docker-compose.yml) Postgres è esposto
# sulla porta 5433 per non entrare in conflitto con quello del CRM-APP.
DATABASE_URL=postgresql://enterprise_user:enterprise_password@localhost:5433/gestionale_enterprise?schema=public

JWT_SECRET=genera-chiave-sicura-min-32-caratteri
JWT_REFRESH_SECRET=genera-altra-chiave-sicura-min-32-caratteri
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Origine ammessa per le richieste CORS dal frontend enterprise
FRONTEND_URL=http://localhost:3100
